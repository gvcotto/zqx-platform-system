NEXT_PUBLIC_SITE_URL=http://localhost:3007
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_HOSTED_DOMAIN=
ZQX_RUNTIME_MODE=development
ZQX_SYSTEM_OWNER_EMAIL=gvcotto@zqxconsulting.com

# Demo-only local authentication. Never set these in production.
# Demo mode is rejected when NODE_ENV=production.
ZQX_DEMO_USER_EMAIL=
ZQX_DEMO_USER_PASSWORD=
ZQX_SYSTEM_AUTH_SECRET=

# Container-only opt-in output; NEXT_PUBLIC_* must match build and runtime.
# ZQX_OUTPUT=standalone
# PORT=3000
# HOSTNAME=0.0.0.0
# NEXT_TELEMETRY_DISABLED=1
